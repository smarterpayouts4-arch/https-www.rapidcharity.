# Copy to .env.local for `next dev` / `next start`. Never commit .env.local.

# Public site URL used for metadata. Defaults to https://www.rapidcharity.org in code.
# NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4721

# --- Local admin (development only) ---
# Used when Firebase Auth is not configured. Disabled automatically once
# NEXT_PUBLIC_FIREBASE_API_KEY and FIREBASE_PROJECT_ID are both set,
# unless ALLOW_LOCAL_ADMIN=1.
# Optional. `npm run dev` with no Firebase keys and no password accepts rapid-local.
ADMIN_LOCAL_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-at-least-16-characters

# --- Firebase Auth (Spark, free) ---
# Web API key and project id are public. Create an email/password user in
# Firebase Authentication and list that email in ADMIN_EMAILS.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_ID=
ADMIN_EMAILS=editor@rapidcharity.org

# --- Firestore (Spark, free) via a service account ---
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the client_email and private_key here. Keep the key in \n form on one line.
# Do not enable billing. Do not use Cloud Storage.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Set to 1 only if you intentionally want the local password in addition to Firebase.
# ALLOW_LOCAL_ADMIN=

# Document uploads. Firebase Storage is not on the Spark plan.
# Prefer the charity Google Drive via Apps Script. See docs/UPLOADS.md.
GOOGLE_DRIVE_UPLOAD_URL=
GOOGLE_DRIVE_UPLOAD_SECRET=

# Used only when the Drive URL is empty. Signed, authenticated Cloudinary uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PKR per 1 USD on the scholarship Summary sheet. A stated review rate, default 278.
REVIEW_USD_RATE=278

# Optional media. Leave blank to use the poster image and the external report link in content.
# MISSION_VIDEO_EMBED_URL=https://www.youtube.com/watch?v=VIDEO_ID
# REPORT_2025_URL=https://example.org/report-2025.pptx
