# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tests
/test-results/
/playwright-report/
/qa/playwright-report/
/qa/apply-flow-shots/
/qa/density-shots/
/blob-report/

# Large local videos — store under public/; content JSON keeps paths only
/public/assets/videos/*.mp4
!/public/assets/videos/.gitkeep

# Scholarship applications (local fallback). Never commit applicant data.
/data/submissions/*
!/data/submissions/.gitkeep

# Uploaded identity documents (local fallback). Never commit applicant files.
/data/uploads/*
!/data/uploads/.gitkeep

# internal design/reference docs (kept locally, not deployed)
/docs/
/.github/workflows/
